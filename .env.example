# Copy to .env.local for local development. Never commit real values.

# Buttondown API key (Settings > API in Buttondown). Server-side only.
BUTTONDOWN_API_KEY=

# Public address of the site, used in email links, robots.txt and the sitemap.
SITE_URL=https://your-site.vercel.app

# Phase 3 data pipeline: `npm run fetch -- YYYY-MM` reads these from the environment
# (in GitHub Actions, add them as repository secrets/variables).
# Free FRED key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Current Apartment List rent-estimates CSV link (changes monthly; from
# https://www.apartmentlist.com/research/category/data-rent-estimates). Optional.
APARTMENTLIST_CSV_URL=
# BLS_API_KEY=
# ANTHROPIC_API_KEY=
